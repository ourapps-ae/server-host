// Rendered by aepm at install from the server-host settings. Run Wrangler from the application's server folder with
// `--config ../components/server-host/server/wrangler.jsonc`; the worker module is server/src/index.ts.
// The Cloudflare account comes from CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN in the environment, never from this file.
{
  "name": "{{roomPrefix}}server",
  "main": "../../../server/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8788 },
  "vars": { "CODE_VERSION": "dev", "WEB_ORIGINS": "{{allowedOrigins}}" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "DIRECTORY", "class_name": "Directory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }]
}
